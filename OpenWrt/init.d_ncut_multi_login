#!/bin/sh /etc/rc.common
# init.d service for NCUT Multi-WAN Auto Login

START=99
USE_PROCD=1
PROG=/etc/ncut_multi_login.sh

# 要監控並自動登入的網路介面 (邏輯名稱)
# 請依據您的 Multi-WAN 設定自行增減
INTERFACES="wan wan2 wan3 wan4"

start_service() {
    for iface in $INTERFACES; do
        # 檢查該網路介面是否存在於系統設定中
        if uci -q get network."$iface" >/dev/null; then
            procd_open_instance "ncut_$iface"
            procd_set_param command /bin/sh "$PROG" "$iface"
            # 支援異常自動重啟 (Respawn)：當進程崩潰時自動拉起
            procd_set_param respawn 3600 5 0
            procd_set_param stdout 1
            procd_set_param stderr 1
            procd_close_instance
        else
            logger -t "ncut-autologin" "介面 $iface 未在 /etc/config/network 中定義，略過啟動。"
        fi
    done
}

service_triggers() {
    # 註冊 procd 觸發器：當這些介面狀態改變時，自動觸發 reload 重新載入設定
    for iface in $INTERFACES; do
        procd_add_interface_trigger "interface.*" "$iface" /etc/init.d/ncut_multi_login reload
    done
}
